{
  "name": "stemm-lab",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~56.0.11",
    "expo": "~56.0.3",
    "expo-background-task": "~56.0.13",
    "expo-battery": "~56.0.4",
    "expo-constants": "~56.0.14",
    "expo-location": "~56.0.12",
    "expo-notifications": "~56.0.12",
    "expo-sensors": "~56.0.5",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-task-manager": "~56.0.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:report": "jest --runInBand --json --outputFile evidence/test-results/jest-results.json",
    "verify": "npm run typecheck && npm run test",
    "export:web": "expo export --platform web",
    "screenshots:mobile": "node scripts/capture-mobile-screenshots.cjs",
    "package:submission": "node scripts/package-submission.cjs"
  },
  "private": true
}
